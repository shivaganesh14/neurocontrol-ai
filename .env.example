# ================================================================
# NeuroControl AI - Frontend Environment Variables
# ================================================================

# Backend API URL
# Local: http://127.0.0.1:5000
# Production: https://neurocontrol-ai.onrender.com
REACT_APP_API_URL=http://127.0.0.1:5000

# Legacy backend URLs, kept only if you still use older integrations
REACT_APP_BACKEND_1_URL=https://neurocontrol-backend-simple.onrender.com
REACT_APP_BACKEND_2_URL=https://neurocontrol-backend-complex.onrender.com

# API Keys (if needed)
REACT_APP_API_KEY=your_api_key_here

# Environment
REACT_APP_ENV=production

# Local backend .env example
PORT=5000
FRONTEND_ORIGIN=http://127.0.0.1:4173

# Leave DATABASE_URL empty locally to use backend/data/neurocontrol-demo.db
SQLITE_PATH=backend/data/neurocontrol-demo.db
DATABASE_URL=
DB_SSL=true

# Optional AI providers. Leave blank unless you have a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini

# For Render production, use DEPLOYMENT_GUIDE.md instead of copying this local file directly.

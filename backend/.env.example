# Local backend
PORT=5000
FRONTEND_ORIGIN=http://127.0.0.1:4173

# Local demo database fallback
# Leave DATABASE_URL empty to use backend/data/neurocontrol-demo.db
SQLITE_PATH=backend/data/neurocontrol-demo.db

# Production database
# Set this on Render/Supabase/Neon for a live Postgres database.
DATABASE_URL=postgresql://user:password@host:5432/database
DB_SSL=true

# Optional model-backed AI
# Free option: create a Gemini API key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional OpenAI alternative. Leave empty if you are using Gemini/local AI.
OPENAI_API_KEY=
AI_MODEL=gpt-5.4-mini
